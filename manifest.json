{
  "manifest_version": 3,
  "name": "接口代理&WS抓包导出工具",
  "version": "0.7",
  "minimum_chrome_version": "102",
  "description": "接口联调辅助工具：域名级接口转发与本地 Mock、WebSocket 抓包导出 JSON，规则仅在已授权域名生效",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "resources": ["ws-hook-source.js", "rules-model.js", "mock-inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
